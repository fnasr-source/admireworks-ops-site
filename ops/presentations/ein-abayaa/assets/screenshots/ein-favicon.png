    <style>
        :root {
            --theme-header-bg: #ffffff;
            --theme-header-text: #1f5f34;
            --theme-header-menu-bg: #f8f5ef;
            --theme-header-menu-text: #102819;
            --theme-footer-bg: #1f5f34;
            --theme-footer-text: #ffffff;
            --editor-ui-font: 'Manrope', Arial, sans-serif;
            --editor-body-font-en: 'Manrope', 'Helvetica Neue', Arial, sans-serif;
            --editor-display-font-en: 'Bodoni Moda', 'Times New Roman', serif;
            --editor-body-font-ar: 'Tajawal', Arial, sans-serif;
            --editor-display-font-ar: 'El Messiri', 'Tajawal', sans-serif;
        }

        html {
            --font-family: var(--editor-body-font-en);
            --font-body: var(--editor-body-font-en);
            --font-ui: var(--editor-body-font-en);
            --font-display: var(--editor-display-font-en);
            --font-heading: var(--editor-display-font-en);
        }

        html[lang="ar"] {
            --font-family: var(--editor-body-font-ar);
            --font-body: var(--editor-body-font-ar);
            --font-ui: var(--editor-body-font-ar);
            --font-display: var(--editor-display-font-ar);
            --font-heading: var(--editor-display-font-ar);
        }

        body,
        .app,
        .main,
        .footer-custom,
        .side-menu,
        .cart-drawer,
        .search-overlay,
        .ein-page-shell,
        .ein-page-shell * {
            font-family: var(--font-body) !important;
        }

        .section-title,
        .ein-editorial-title,
        .ein-pdp-title,
        .ein-cart-title,
        .ein-catalog-banner-copy h1,
        .ein-collection-card-copy h2,
        h1,
        h2,
        h3,
        h4,
        h5,
        h6 {
            font-family: var(--font-display) !important;
        }

        .navbar.scrolled,
        body[data-template]:not([data-template="home"]) .navbar,
        body[data-template]:not([data-template="home"]) .nav-main,
        body[data-template]:not([data-template="home"]) .header {
            background: var(--theme-header-bg) !important;
            color: var(--theme-header-text) !important;
        }

        .navbar.scrolled .icon-btn,
        .navbar.scrolled a,
        .navbar.scrolled .brand-logo-link,
        .navbar.scrolled i,
        .navbar.scrolled span,
        body[data-template]:not([data-template="home"]) .navbar .icon-btn,
        body[data-template]:not([data-template="home"]) .navbar a,
        body[data-template]:not([data-template="home"]) .navbar .brand-logo-link,
        body[data-template]:not([data-template="home"]) .nav-main i,
        body[data-template]:not([data-template="home"]) .nav-main span {
            color: var(--theme-header-text) !important;
        }

        body[data-template="home"] .header,
        body[data-template="home"] .navbar:not(.scrolled),
        body[data-template="home"] .navbar:not(.scrolled) .nav-main {
            background: transparent !important;
            color: #ffffff !important;
            box-shadow: none !important;
        }

        body[data-template="home"] .navbar:not(.scrolled) .icon-btn,
        body[data-template="home"] .navbar:not(.scrolled) a,
        body[data-template="home"] .navbar:not(.scrolled) .brand-logo-link,
        body[data-template="home"] .navbar:not(.scrolled) i,
        body[data-template="home"] .navbar:not(.scrolled) span {
            color: #ffffff !important;
        }

        .nav-announcement,
        .nav-announcement p,
        .nav-announcement a {
            color: inherit !important;
        }

        .side-menu.ein-hybrid-menu {
            background: var(--theme-header-menu-bg) !important;
            color: var(--theme-header-menu-text) !important;
        }

        .side-menu.ein-hybrid-menu a,
        .side-menu.ein-hybrid-menu span,
        .side-menu.ein-hybrid-menu i,
        .side-menu.ein-hybrid-menu strong {
            color: var(--theme-header-menu-text) !important;
        }

        .footer-custom {
            background: var(--theme-footer-bg) !important;
            color: var(--theme-footer-text) !important;
        }

        .footer-custom,
        .footer-custom p,
        .footer-custom span,
        .footer-custom strong,
        .footer-custom h3,
        .footer-custom a {
            color: var(--theme-footer-text) !important;
        }
    </style>

</head>

