        </form>
    </div>

    <div id="cart-drawer-overlay" class="cart-drawer-overlay" onclick="closeCartDrawer()"></div>

    <!-- Cart Drawer -->
    <aside id="cart-drawer" class="cart-drawer" aria-hidden="true">
        <div class="cart-drawer-shell">
            <div class="cart-drawer-header">
                <div class="cart-drawer-heading">
                    <span class="cart-drawer-kicker">اختياراتك</span>
                    <h3 class="cart-drawer-title">السلة <span id="cart-drawer-count">(0)</span></h3>
                </div>
                <button class="icon-btn cart-drawer-close" type="button" onclick="closeCartDrawer()" aria-label="إغلاق">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <div class="cart-drawer-body">
                <div id="cart-drawer-empty" class="cart-drawer-empty">
                    <p class="cart-drawer-empty-title">سلتك فارغة حالياً.</p>
                    <p class="cart-drawer-empty-copy">أضيفي التصاميم التي أحببتِها لتظهري هنا، ثم تابعي إلى إتمام الطلب عندما تكونين جاهزة.</p>
                    <a href="/products/" class="cart-drawer-secondary-link">متابعة التسوق</a>
                </div>
                <div id="cart-drawer-items" class="cart-drawer-items" aria-live="polite"></div>

                <section id="cart-drawer-recommendations" class="cart-drawer-recommendations" hidden>
                    <div class="cart-drawer-recommendations-head">
                        <h4 class="cart-drawer-recommendations-title">قد يعجبك أيضاً</h4>
                        <div id="cart-drawer-recommendations-controls" class="cart-drawer-recommendations-controls" hidden>
                            <button type="button" class="cart-drawer-recommendations-arrow is-prev" onclick="einCartDrawerScrollRecommendations(-1)" aria-label="السابق">
                                <i class="fa-solid fa-angle-left"></i>
                            </button>
                            <button type="button" class="cart-drawer-recommendations-arrow is-next" onclick="einCartDrawerScrollRecommendations(1)" aria-label="التالي">
                                <i class="fa-solid fa-angle-right"></i>
                            </button>
                        </div>
                    </div>
                    <div id="cart-drawer-recommendations-track" class="cart-drawer-recommendations-track"></div>
                </section>
            </div>

            <div id="cart-drawer-footer" class="cart-drawer-footer" hidden>
                <div class="cart-drawer-summary-row">
                    <span>المجموع الفرعي</span>
                    <strong id="cart-drawer-total">0</strong>
                </div>
                <p class="cart-drawer-note">الضرائب والخصومات ورسوم الشحن تُحسب عند الدفع.</p>
                <div class="cart-drawer-cta-head">
                    <span class="cart-drawer-cta-label">الخطوة التالية</span>
