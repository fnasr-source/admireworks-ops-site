            .loyalty-rewards-popup {
                display: flex;
                align-items: center;
                justify-content: center;
            }

            .loyalty-rewards-popup__wrap {
                width: 90%;
                position: absolute;
                max-width: 440px;
                max-height: 85vh;
                overflow: scroll;
                border-radius: 20px;
                scrollbar-width: none;
            }

            .loyalty-rewards-popup__wrap::-webkit-scrollbar {
                width: 0px;
