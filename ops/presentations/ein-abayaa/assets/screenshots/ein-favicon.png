    <script>
    /* ── LOADING BAR ── */
    (function () {
        var bar = document.getElementById('ein-loading-bar');
        var width = 0;
        var interval = null;

        function startLoading() {
            if (!bar) return;
            clearInterval(interval);
            width = 0;
            bar.style.width = '0%';
            bar.classList.remove('ein-loading-done');
            bar.classList.add('ein-loading-active');
            interval = setInterval(function () {
                if (width < 85) {
                    width += Math.random() * 8;
                    if (width > 85) width = 85;
                    bar.style.width = width + '%';
                }
            }, 200);
        }

        function finishLoading() {
            if (!bar) return;
            clearInterval(interval);
            bar.classList.add('ein-loading-done');
            setTimeout(function () {
                bar.classList.remove('ein-loading-active', 'ein-loading-done');
                bar.style.width = '0%';
            }, 700);
        }

        document.addEventListener('click', function (e) {
            var link = e.target.closest('a');
            if (!link) return;
            var href = link.getAttribute('href');
            if (!href || href.startsWith('#') || href.startsWith('javascript') || link.target === '_blank') return;
            startLoading();
        });

        window.addEventListener('pageshow', finishLoading);
        window.addEventListener('load', finishLoading);
    })();

    /* ── QUICK ADD: size button ── */
    window.einQuickAddSize = function (event, productId, valueId) {
        event.preventDefault();
        event.stopPropagation();
        var btn = event.currentTarget;
        btn.classList.add('ein-size-adding');
        var originalText = btn.textContent;
        btn.textContent = '...';

        /* Use Zid's native cart API */
        try {
            zid.cart.addProduct({ product_id: productId, option_id: valueId, quantity: 1 })
                .then(function (response) {
                    btn.textContent = '✓';
                    setTimeout(function () {
                        btn.textContent = originalText;
                        btn.classList.remove('ein-size-adding');
                    }, 1200);
                    if (window.setCartBadge && typeof response?.cart_items_quantity !== 'undefined') {
                        window.setCartBadge(response.cart_items_quantity);
                    }
                    if (window.einHandleCartMutation) {
                        window.einHandleCartMutation(response, { source: 'quick_add_size' });
                    } else if (window.einOpenCartDrawerAfterAdd) {
                        window.einOpenCartDrawerAfterAdd(response);
                    }
                })
                .catch(function () {
                    btn.textContent = originalText;
                    btn.classList.remove('ein-size-adding');
                    /* Fallback: open product page */
                    window.location.href = btn.closest('a') ? btn.closest('a').href : '/products';
                });
        } catch (err) {
            /* Fallback if zid object unavailable */
            btn.textContent = originalText;
            btn.classList.remove('ein-size-adding');
        }
    };

    /* ── QUICK ADD: no-options product ── */
    window.einQuickAddDirect = function (event, productId) {
        event.preventDefault();
        event.stopPropagation();
        var btn = event.currentTarget;
        // Try Zid cart API first
        if (typeof zid !== 'undefined' && zid.cart && typeof zid.cart.addProduct === 'function') {
            try {
                zid.cart.addProduct({ product_id: productId, quantity: 1 })
                    .then(function (response) {
                        if (window.setCartBadge && typeof response?.cart_items_quantity !== 'undefined') {
                            window.setCartBadge(response.cart_items_quantity);
                        }
                        if (window.einHandleCartMutation) {
                            window.einHandleCartMutation(response, { source: 'quick_add_direct' });
                        } else if (window.einOpenCartDrawerAfterAdd) {
                            window.einOpenCartDrawerAfterAdd(response);
                        }
                    })
                    .catch(function () {
                        // Fallback: navigate to the product page
                        var card = btn.closest('a');
                        if (card && card.href) window.location.href = card.href;
                    });
            } catch (err) {
                var card = btn.closest('a');
                if (card && card.href) window.location.href = card.href;
            }
        } else {
            // No Zid API: navigate to product page
            var card = btn.closest('a');
            if (card && card.href) window.location.href = card.href;
        }
    };
    </script>




  
